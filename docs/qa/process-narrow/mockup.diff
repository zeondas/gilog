+ */
+const NOTE_MIN = 140;
+const SUM_MIN = 120;
+const PLACE_MIN = 110;
+function fitProcess(ws: (number | null)[], avail: number): { ws: (number | null)[]; flexMin: number } {
+  const out = ws.slice();
+  if (!(avail > 0)) return { ws: out, flexMin: FLEX_MIN };
+  const sum = out.reduce<number>((a, w) => a + (w ?? 0), 0);
+  let over = sum + FLEX_MIN - avail;
+  if (over <= 0) return { ws: out, flexMin: FLEX_MIN };
+  const cut = (i: number, min: number) => {
+    const w = out[i] ?? 0;
+    const c = Math.max(0, Math.min(over, w - min));
+    out[i] = w - c;
+    over -= c;
+  };
+  cut(7, NOTE_MIN);
+  let flexMin = FLEX_MIN;
+  if (over > 0) {
+    const c = Math.min(over, FLEX_MIN - SUM_MIN);
+    flexMin -= c;
+    over -= c;
+  }
+  if (over > 0) cut(4, PLACE_MIN);
+  return { ws: out, flexMin };
+}
