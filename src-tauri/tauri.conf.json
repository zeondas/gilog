{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "giLog",
  "version": "0.27.0",
  "identifier": "kr.gilog.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "기록",
        "generalAutofillEnabled": false,
        "width": 1600,
        "height": 900,
        "center": true,
        "minWidth": 1024,
        "minHeight": 700,
        "visible": false,
        "create": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**/*.jpg", "**/*.jpeg", "**/*.png", "**/*.gif", "**/*.bmp", "**/*.webp", "**/*.JPG", "**/*.JPEG", "**/*.PNG", "**/*.GIF", "**/*.BMP", "**/*.WEBP"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Korean"]
      }
    }
  }
}
